# Copy this file to .env and fill in whichever providers you want to use.
#
# The app tries providers IN ORDER and automatically falls through to the
# next one if a provider fails or is rate-limited. You do NOT need to fill
# in all 7 — any provider left with an empty key is skipped. Filling in at
# least 2-3 is strongly recommended so a single provider's outage never
# blocks the app.
#
# Two separate orders: English requests use LLM_PROVIDER_ORDER_EN (Groq
# first — fastest, most reliable). Telugu requests use LLM_PROVIDER_ORDER_TE
# (Sarvam first — an Indian company building models specifically for Indian
# languages, genuinely more natural spoken Telugu than any general-purpose
# model here; Gemini second as backup). Sarvam is deliberately EXCLUDED from
# the English order — it's kept for Telugu only, both to conserve its
# fixed credit pool and because Groq/Cerebras/Mistral are all better suited
# to English than paying for Sarvam credits on a language it's not
# specialized for.
LLM_PROVIDER_ORDER_EN=groq,mistral,gemini,openai
LLM_PROVIDER_ORDER_TE=sarvam,gemini,groq,mistral,openai

# --- 1. Groq (recommended primary) ---
# Free, no credit card, fast, no billing-link bugs. Groq deprecates models
# fairly often (llama-3.3-70b-versatile was shut down Aug 16, 2026) — check
# https://console.groq.com/docs/models if the default below 404s.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=openai/gpt-oss-120b


# --- 3. Mistral ---
# Free "Experiment" tier, 1B tokens/month, broadest model access.
# Get a key: https://console.mistral.ai
MISTRAL_API_KEY=your_mistral_key_here


# --- 5. Sarvam AI (recommended for Telugu) ---
# Indian company (Bengaluru) building models specifically for 22 Indian
# languages, not as a side feature — routed first for Telugu requests.
# Free tier: ~₹100-1,000 one-time signup credits, NOT a perpetual daily/
# monthly-reset free tier like the others — once spent, requires payment.
# Get a key: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here
# SARVAM_MODEL=sarvam-105b   # sarvam-30b was deprecated Aug 2026; 105b is now the only current option

# --- 6. Gemini ---
# Free tier has been unreliable since late 2025 (Google cut quotas, and
# newly created API keys have shown "limit: 0" bugs even on paid tiers, plus
# real-world testing has seen daily limits as low as 20 requests/day on some
# accounts). Google also retires Gemini model generations very fast (2.5 ->
# 3 -> 3.5 -> 3.6 within months) — if you see a 404 "no longer available"
# error, either leave GEMINI_MODEL unset (it defaults to the self-updating
# "gemini-flash-latest" alias) or check the current model list at
# https://ai.google.dev/gemini-api/docs/models and override GEMINI_MODEL
# below without needing a code change.
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-flash-latest

# --- 7. OpenAI (optional, off by default) ---
# NOT a true free tier — a one-time trial credit that expires, then requires
# billing. Doesn't fit the free-tier-first approach used everywhere else in
# this app, so it's last in both orders and inactive unless you add a key.
# Only useful as an opt-in paid boost on top of the free chain.
# Get a key: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here

# --- Storage (defaults are fine for local dev) ---
# For deployment where data needs to survive restarts (free hosting tiers use
# ephemeral disks — SQLite resets on every redeploy/restart/wake-from-sleep),
# point this at a free Postgres instance instead — Neon (neon.tech) and
# Supabase (supabase.com) both have genuinely free-forever tiers, no card
# required. Paste the connection string they give you directly; both
# "postgres://" and "postgresql://" URL formats work.
DATABASE_URL=sqlite:///./medreport.db
UPLOAD_DIR=./storage/uploads
VECTOR_STORE_DIR=./storage/vector_store

# --- CORS: add your deployed frontend URL here in production ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
